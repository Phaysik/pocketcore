{
	"tasks": [
		{
			"type": "shell",
			"label": "Release build",
			"command": "make",
			"args": ["-j4 release"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"type": "shell",
			"label": "Dev build",
			"command": "make",
			"args": ["-j4 dev"],
			"group": {
				"kind": "build"
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"type": "shell",
			"label": "Debug build",
			"command": "make",
			"args": ["-j4 debug"],
			"group": {
				"kind": "build"
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"type": "shell",
			"label": "Debug tests",
			"command": "make",
			"args": ["-j4 build_tests"],
			"group": {
				"kind": "build"
			},
			"problemMatcher": ["$gcc"]
		}
	],
	"version": "2.0.0"
}
